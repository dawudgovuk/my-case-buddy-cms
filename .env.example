# Strapi Headless CMS API Endpoint
# Default local dev port for Strapi is 1337
VITE_STRAPI_API_URL=http://localhost:1337

# Feature Flag: Set to true to switch cases persistence from LocalStorage to live Strapi REST API
VITE_USE_STRAPI=false

# Clerk Authentication (Optional Client-Side Credentials)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
